# Firebase project credentials (web app config).
# Copy this file to `.env.local` and fill in values from the Firebase console:
#   console.firebase.google.com → project settings → Your apps → Web app → SDK setup.
#
# Leave values blank to run against the local in-browser mock backend.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

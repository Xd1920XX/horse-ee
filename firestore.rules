rules_version = '2';

// Security rules per CLAUDE.md §8. Roles live in /users/{uid}.roles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc(request.auth.uid).roles[role] == true;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOrganizerOf(compId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/competitions/$(compId)).data.organizerUid == request.auth.uid;
    }

    function isJudgeOf(compId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/competitions/$(compId)).data.judgeUids;
    }

    // ---- Users ----
    match /users/{uid} {
      // Public read — display names appear on protocols anyway.
      allow read: if true;
      // Only the owner can create their own user doc at sign-up.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.roles.admin == false;
      // Owner can update their own doc. Organizer role self-toggleable; admin stays locked.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.roles.admin == resource.data.roles.admin;
      // Admin can update anything, including admin role.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Horses ----
    match /horses/{horseId} {
      // Public read — horse name visible on protocols anyway.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ---- Courses (designer) ----
    match /courses/{courseId} {
      // Public read — courses linked to competitions must be visible to riders.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ---- Competitions ----
    match /competitions/{cid} {
      // All competition metadata is publicly listable (venue/date/status are not sensitive).
      // Draft hiding happens client-side so onSnapshot queries don't need per-doc rule checks.
      allow read: if true;
      // Only organizers can create.
      allow create: if hasRole('organizer')
        && request.resource.data.organizerUid == request.auth.uid;
      allow update: if isOrganizerOf(cid) || isAdmin();
      // Delete only allowed on drafts — published events must stay in archive.
      allow delete: if (isOrganizerOf(cid) && resource.data.status == 'draft') || isAdmin();

      // ---- Classes (sub) ----
      match /classes/{clid} {
        // Public read — class metadata (height, rules) is public info.
        allow read: if true;
        allow write: if isOrganizerOf(cid) || isAdmin();
      }

      // ---- Registrations (sub) ----
      match /registrations/{rid} {
        // Public read — participant list is public (standard for horse shows).
        allow read: if true;
        // Riders can register themselves when competition is open.
        // Organizers can register themselves at any status (useful for testing / own event).
        allow create: if isSignedIn()
          && request.resource.data.riderUid == request.auth.uid
          && (
            get(/databases/$(database)/documents/competitions/$(cid)).data.status == 'open'
            || isOrganizerOf(cid)
          );
        // Rider can withdraw themselves; organizer can set any status.
        allow update: if isOrganizerOf(cid) || isAdmin()
          || (isSignedIn() && resource.data.riderUid == request.auth.uid
              && request.resource.data.status == 'withdrawn');
        allow delete: if isOrganizerOf(cid) || isAdmin();
      }

      // ---- Starts (sub) ----
      match /starts/{sid} {
        // Public protocol access.
        allow read: if true;
        allow write: if isOrganizerOf(cid) || isJudgeOf(cid) || isAdmin();
      }

      // ---- Awards (sub) ----
      match /awards/{classId} {
        allow read: if true;
        allow write: if isOrganizerOf(cid) || isAdmin();
      }
    }
  }
}
